# Stage 1: Build environment with eBPF toolchain
FROM golang:1.26.8-bookworm@sha256:a688600ca24f8a4d3ca77f95b0dd40704a9fc787c826660eb7ba0b641b8b175d AS builder

# Install eBPF build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    clang-16 \
    llvm-16 \
    libelf-dev \
    libc6-dev \
    wget \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Verify downloaded executable bytes before allowing the build to execute them.
RUN ARCH=$(dpkg --print-architecture) && \
    case "$ARCH" in \
      amd64) OPA_SHA256=1a2337dbd75d623d759c9e47f64564f101b6923b069663f06f14377b6bb83119 ;; \
      arm64) OPA_SHA256=4553440d99b858f657750a510ac08d67acb078bcbcf62ed666c5df0a4d9d45ab ;; \
      *) exit 1 ;; \
    esac && \
    wget -q -O /usr/local/bin/opa https://openpolicyagent.org/downloads/v1.4.0/opa_linux_${ARCH}_static \
    && printf '%s  %s\n' "$OPA_SHA256" /usr/local/bin/opa | sha256sum -c - \
    && chmod +x /usr/local/bin/opa

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download

COPY . .

# Download GitHub meta for OPA bundle
RUN wget -q --timeout=30 --tries=3 https://api.github.com/meta -O ./bundle/assets/github/data.json || true

# Compile eBPF C code for x86_64.
ENV BPF_CLANG=clang-16
ENV BPF_CFLAGS="-O2 -g -Wall -Werror"
ENV BPF_HEADERS=/src/bpf/headers
RUN GOARCH=amd64 go generate ./...

# Build the binary for x86_64 Linux
RUN CGO_ENABLED=0 GOARCH=amd64 go build -o /src/kntrl .

# Stage 2: Test runner
FROM builder AS test-runner

LABEL purpose="kntrl-test"

WORKDIR /src

ENTRYPOINT ["/bin/bash", "-c"]
CMD ["make test-all-docker"]
