# Stage 1: Build environment with eBPF toolchain
FROM golang:1.25-bookworm@sha256:3b4a11519ad929d1e1d261a12cff056f0c85b735253d7d861346b9c6f8b36437 AS builder

# Install eBPF build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    clang-16 \
    llvm-16 \
    libelf-dev \
    libc6-dev \
    wget \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Verify downloaded executable bytes before allowing the build to execute them.
RUN ARCH=$(dpkg --print-architecture) && \
    case "$ARCH" in \
      amd64) OPA_SHA256=dfd5081fc6f930dfeaf2a225e31e616fc227dc0c7b43019b73d6f8fb8a1de1aa ;; \
      arm64) OPA_SHA256=1a583e593cdf4931c0b0bbedd3c9f585012953449115bcc3e15b3806d0f5ee68 ;; \
      *) exit 1 ;; \
    esac && \
    wget -q -O /usr/local/bin/opa https://openpolicyagent.org/downloads/v0.68.0/opa_linux_${ARCH}_static \
    && printf '%s  %s\n' "$OPA_SHA256" /usr/local/bin/opa | sha256sum -c - \
    && chmod +x /usr/local/bin/opa

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download

COPY . .

# Download GitHub meta for OPA bundle
RUN wget -q --timeout=30 --tries=3 https://api.github.com/meta -O ./bundle/assets/github/data.json || true

# Compile eBPF C code for x86_64.
ENV BPF_CLANG=clang-16
ENV BPF_CFLAGS="-O2 -g -Wall -Werror"
ENV BPF_HEADERS=/src/bpf/headers
RUN GOARCH=amd64 go generate ./...

# Build the binary for x86_64 Linux
RUN CGO_ENABLED=0 GOARCH=amd64 go build -o /src/kntrl .

# Stage 2: Test runner
FROM builder AS test-runner

LABEL purpose="kntrl-test"

WORKDIR /src

ENTRYPOINT ["/bin/bash", "-c"]
CMD ["make test-all-docker"]
